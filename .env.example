# ============================================================
# Hamplard Backend — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Public origins used when generating certificate and other share links
APP_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3001
# CERTIFICATE_SHARE_IMAGE_URL=https://example.com/default-certificate-preview.png

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://hamplard:password@localhost:5432/hamplard_db

# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployed Hamplard contract ID (from hamplard-contract deploy)
HAMPLARD_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_TOKEN_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Admin Stellar address — must match the admin set at contract init
ADMIN_STELLAR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Platform treasury address — receives platform fee share
TREASURY_STELLAR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# File storage (local for dev — swap for S3/Cloudinary in production)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# CDN media delivery
CDN_BASE_URL=https://cdn.hamplard.com
CDN_ORIGIN_BASE_URL=http://localhost:3000
CDN_SIGNING_SECRET=change-me-cdn-signing-secret
CDN_SIGNED_URL_TTL_SECONDS=3600
# Optional purge endpoint for cache invalidation
# CDN_PURGE_URL=https://cdn.hamplard.com/api/purge
# CDN_PURGE_TOKEN=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@hamplard.com

# Redis — API response caching layer (issue #92)
# REDIS_URL takes precedence over the individual host/port/password vars below
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Per-IP rate limiting middleware (issue #71)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STANDARD_MAX=100
RATE_LIMIT_SENSITIVE_MAX=10
# Comma-separated trusted IPs that bypass rate limiting (health probes, internal services)
RATE_LIMIT_EXEMPT_IPS=

# Role-based throttling — requests per minute per bucket (issue #72)
ROLE_THROTTLE_WINDOW_MS=60000
ROLE_THROTTLE_ANON_LIMIT=20
ROLE_THROTTLE_STUDENT_LIMIT=60
ROLE_THROTTLE_INSTRUCTOR_LIMIT=120
ROLE_THROTTLE_ADMIN_LIMIT=300

# Event polling interval (ms)
EVENT_POLLING_INTERVAL_MS=5000

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3001

# Certificate issuer name (appears in email notifications)
PLATFORM_NAME=Hamplard

# ============================================================
# Fraud Detection — Enrollment Risk Scoring Thresholds
# ============================================================

# Rolling window (hours) used for rapid-repeat-purchase detection
FRAUD_WINDOW_HOURS=1

# Max enrollments allowed within FRAUD_WINDOW_HOURS before RAPID_REPEAT_PURCHASE fires (+40 pts)
FRAUD_MAX_ENROLLMENTS_PER_WINDOW=3

# Max enrollments allowed in 24 h before HIGH_DAILY_VOLUME fires (+25 pts)
FRAUD_MAX_DAILY_ENROLLMENTS=10

# Max simultaneously ACTIVE enrollments before EXCESSIVE_ACTIVE_ENROLLMENTS fires (+20 pts)
FRAUD_MAX_ACTIVE_ENROLLMENTS=20

# USDC amount above which HIGH_AMOUNT_ANOMALY fires (+15 pts)
FRAUD_HIGH_AMOUNT_THRESHOLD_USDC=500

# Score threshold at which an enrollment is FLAGGED (flag persisted, enrollment proceeds)
FRAUD_HIGH_RISK_SCORE_THRESHOLD=70

# Score threshold at which an enrollment is BLOCKED (automatic hold, HTTP 423 returned)
FRAUD_CRITICAL_SCORE_THRESHOLD=90

# Referral program (enrollment discounts)
REFERRAL_REFERRER_DISCOUNT_PERCENT=10
REFERRAL_REFEREE_DISCOUNT_PERCENT=10
REFERRAL_REWARD_EXPIRY_DAYS=90
REFERRAL_MAX_REWARDS_PER_REFERRER=50

# SMS (Africa's Talking regional gateway)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=Hamplard

# OTP Configuration
# OTP expires after 10 minutes
# Maximum 5 verification attempts per OTP
# Rate limit: 3 OTP requests per minute per phone number
# ============================================================
# Webhook Signature Verification
# Used by WebhookSignatureMiddleware to validate inbound webhook payloads
# via HMAC-SHA256. All webhook routes under /api/v1/webhooks/* are protected.
# ============================================================

# Default secret — used when no provider-specific secret matches.
WEBHOOK_SECRET=change-me-webhook-signing-secret

# Provider-specific secrets (optional — override the default per provider).
# The provider name is the path segment after /webhooks/, e.g.:
#   POST /api/v1/webhooks/stripe  → uses WEBHOOK_SECRET_STRIPE
#   POST /api/v1/webhooks/africastalking → uses WEBHOOK_SECRET_AFRICASTALKING
# WEBHOOK_SECRET_STRIPE=your-stripe-webhook-signing-secret
# WEBHOOK_SECRET_AFRICASTALKING=your-africastalking-webhook-secret
# WEBHOOK_SECRET_GITHUB=your-github-webhook-secret
