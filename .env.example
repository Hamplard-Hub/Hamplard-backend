# ============================================================
# Hamplard Backend — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ============================================================
# Server & Application Configuration
# ============================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Express trust proxy for req.ip (rate limiting, logs). Default unset/false uses
# the TCP peer address and ignores X-Forwarded-For. Do NOT set this to true on a
# public server — clients can spoof forwarded headers. Behind a single known
# reverse proxy (nginx, ALB, Cloudflare), set hop count 1. You may also list
# trusted proxy IPs or CIDRs, comma-separated.
TRUST_PROXY=false
# Public origins used when generating certificate and other share links
APP_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3001
# Comma-separated exact origins (scheme + host + optional port), without paths.
# Whitespace and empty entries are ignored; wildcards are not supported.
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:3001

# Platform information
PLATFORM_NAME=Hamplard
PLATFORM_FEE_PERCENT=20

# Swagger OpenAPI Documentation (enabled by default in non-production)
SWAGGER_ENABLED=true

# Structured logging (issue #89) — fatal | error | warn | info | debug | trace | silent
# Defaults to "debug" in development and "info" in production when unset.
LOG_LEVEL=debug

# ============================================================
# Sentry Error Monitoring (issue #91)
# ============================================================
# Leave SENTRY_DSN empty to disable error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Set to the deployed version or commit SHA in CI/CD.
SENTRY_RELEASE=hamplard-backend@0.1.0

# ============================================================
# Authentication & Security (JWT, OAuth, OTP, Captcha)
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Phone OTP Verification (HMAC secret for hashing OTP codes before DB storage)
OTP_HMAC_SECRET=change-me-otp-hmac-secret

# CAPTCHA verification (required before auth nonce issuance)
# Server-side secret only — never a client-reported success flag
CAPTCHA_SECRET_KEY=your-captcha-secret-key
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
CAPTCHA_TIMEOUT_MS=5000
CAPTCHA_MAX_FAILURES=5
CAPTCHA_BLOCK_DURATION_SECONDS=900

# TOTP brute-force protection (per-account, shared by login / Google token login / 2FA disable)
TOTP_MAX_FAILED_ATTEMPTS=5
TOTP_LOCKOUT_SECONDS=900

# ============================================================
# Database (PostgreSQL via Prisma)
# ============================================================
DATABASE_URL=postgresql://hamplard:password@localhost:5432/hamplard_db

# ============================================================
# Stellar Network & Soroban Smart Contracts
# ============================================================
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployed Hamplard contract ID (from hamplard-contract deploy)
HAMPLARD_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Event polling interval (ms) — Stellar event poller tick, default 5000.
EVENT_POLLING_INTERVAL_MS=5000

# --- Reserved Variables (not read directly by API core; reserved for scripts) ---
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# USDC_TOKEN_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# ADMIN_STELLAR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TREASURY_STELLAR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================
# Redis & BullMQ Queue / Caching
# ============================================================
# REDIS_URL takes precedence over individual REDIS_HOST/PORT/PASSWORD
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Durable job queue settings
QUEUE_JOB_ATTEMPTS=5
QUEUE_RETRY_DELAY_MS=5000
CACHE_TTL_SECONDS=60

# ============================================================
# File Storage, CDN & Antivirus (ClamAV)
# ============================================================
UPLOAD_DIR=./uploads
# Global upload ceiling; per-category limits below are capped by it
MAX_FILE_SIZE_MB=500
MAX_IMAGE_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=25
MAX_KYC_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
FALLBACK_THUMBNAIL_PATH=./assets/default-thumbnail.png

# Antivirus Scanning (ClamAV)
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_MAX_RETRIES=3
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT=5000

# CDN media delivery & Signed URLs
CDN_BASE_URL=https://cdn.hamplard.com
CDN_ORIGIN_BASE_URL=http://localhost:3000/api/v1
CDN_SIGNING_SECRET=change-me-cdn-signing-secret
CDN_SIGNED_URL_TTL_SECONDS=3600
# Optional purge endpoint for cache invalidation
CDN_PURGE_URL=https://cdn.hamplard.com/api/purge
CDN_PURGE_TOKEN=your-cdn-purge-token
# Social sharing certificate preview image
CERTIFICATE_SHARE_IMAGE_URL=https://example.com/default-certificate-preview.png

# ============================================================
# Email (Nodemailer)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@hamplard.com

# ============================================================
# Push Notifications (Firebase Cloud Messaging - HTTP v1)
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-abcde@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Deprecated / Legacy FCM (FCM HTTP v1 above is used instead) ---
# FIREBASE_SERVER_KEY=legacy-server-key-deprecated
# FIREBASE_FCM_URL=https://fcm.googleapis.com/fcm/send

# ============================================================
# SMS Gateway (Africa's Talking)
# ============================================================
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=Hamplard
SMS_WEBHOOK_SECRET=your-sms-webhook-secret

# ============================================================
# Rate Limiting & Throttling
# ============================================================
# Default ThrottlerGuard limits for auth routes; nonce and login use stricter route-specific limits.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Per-IP rate limiting middleware (issue #71)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STANDARD_MAX=100
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_EXEMPT_IPS=

# Role-based throttling — requests per minute per bucket (issue #72)
ROLE_THROTTLE_WINDOW_MS=60000
ROLE_THROTTLE_ANON_LIMIT=20
ROLE_THROTTLE_STUDENT_LIMIT=60
ROLE_THROTTLE_INSTRUCTOR_LIMIT=120
ROLE_THROTTLE_ADMIN_LIMIT=300

# ============================================================
# Nightly Database Backups & Audit Retention
# ============================================================
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=database-backups
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_RETENTION_DAYS=30
AWS_REGION=us-east-1

# Retention period (in days) for admin audit logs
AUDIT_LOG_RETENTION_DAYS=90

# Cron Monitor Housekeeping
CRON_RUN_RETENTION_DAYS=30
CRON_STALE_THRESHOLD_MINUTES=60

# ============================================================
# Search Engine (Meilisearch)
# ============================================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ============================================================
# Fraud Detection & Referral Program
# ============================================================
FRAUD_WINDOW_HOURS=1
FRAUD_MAX_ENROLLMENTS_PER_WINDOW=3
FRAUD_MAX_DAILY_ENROLLMENTS=10
FRAUD_MAX_ACTIVE_ENROLLMENTS=20
FRAUD_HIGH_AMOUNT_THRESHOLD_USDC=500
FRAUD_HIGH_RISK_SCORE_THRESHOLD=70
FRAUD_CRITICAL_SCORE_THRESHOLD=90

# Referral program
REFERRAL_REFERRER_DISCOUNT_PERCENT=10
REFERRAL_REFEREE_DISCOUNT_PERCENT=10
REFERRAL_REWARD_EXPIRY_DAYS=90
REFERRAL_MAX_REWARDS_PER_REFERRER=50

# ============================================================
# Webhook Signature Verification
# ============================================================
WEBHOOK_SECRET=change-me-webhook-signing-secret
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_SIGNATURE_EXCLUDE_PATHS=webhooks/ping

# Provider-specific secrets (e.g. WEBHOOK_SECRET_STRIPE, WEBHOOK_SECRET_AFRICASTALKING)
WEBHOOK_SECRET_STRIPE=your-stripe-webhook-signing-secret
WEBHOOK_SECRET_AFRICASTALKING=your-africastalking-webhook-secret
