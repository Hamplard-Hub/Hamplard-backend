{
  "name": "hamplard-backend",
  "version": "0.1.0",
  "description": "Hamplard — NestJS backend for the online vocational skills learning platform",
  "author": "Hamplard Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/terminus": "^10.1.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.6.0",
    "@sentry/node": "^11.0.0",
    "@modernized/fluent-ffmpeg": "^1.0.3",
    "@stellar/stellar-sdk": "^16.4.1",
    "africastalking": "^0.8.4",
    "axios": "^1.21.1",
    "bad-words": "^3.0.4",
    "bullmq": "^5.81.3",
    "cache-manager": "^5.4.0",
    "clamscan": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "meilisearch": "^0.40.0",
    "multer": "^2.5.0",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^10.6.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bad-words": "^3.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^3.0.9",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "prisma": "^5.6.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "glob": {
      ".": "^13.0.6",
      "minimatch": "^11.0.9"
    },
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "follow-redirects": "^1.16.3",
    "axios": "^1.21.1",
    "joi": "^18.3.2",
    "@nestjs/platform-express": {
      "body-parser": "^1.20.9"
    },
    "africastalking": {
      "body-parser": "^2.4.0"
    },
    "tmp": "^0.2.7",
    "multer": "^2.5.0",
    "@angular-devkit/core": {
      "picomatch": "^4.0.7"
    },
    "test-exclude": {
      "minimatch": "^11.0.9"
    },
    "@sentry/bundler-plugins": {
      "minimatch": "^11.0.9"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.9"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "allowJs": true } }]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*(@noble|uint8array-extras|feaxios|smol-toml|base32\\.js)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
