// prisma/schema.prisma
// Hamplard — Database schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT         // instructor editing, not yet submitted
  PENDING       // submitted for admin review
  ACTIVE        // approved and enrollable
  PAUSED        // temporarily unavailable
  ARCHIVED      // permanently removed
}

enum EnrollmentStatus {
  ACTIVE        // enrolled and learning
  COMPLETED     // finished all lessons
  REFUNDED      // refunded (edge case)
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum CommentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  PENDING       // student not submitted yet
  SUBMITTED     // student submitted, awaiting review
  APPROVED      // instructor approved
  REJECTED      // instructor rejected, student must resubmit
}

enum NotificationType {
  COURSE_APPROVED
  COURSE_REJECTED
  ENROLLMENT_CONFIRMED
  LESSON_UNLOCKED
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_APPROVED
  ASSIGNMENT_REJECTED
  COURSE_COMPLETED
  CERTIFICATE_ISSUED
  NEW_ENROLLMENT        // for instructors
  PAYMENT_RECEIVED      // for instructors
  LIVE_SESSION_REMINDER // for scheduled live sessions
  DISPUTE_FILED
  DISPUTE_RESOLVED
  KYC_APPROVED
  KYC_REJECTED
  PAYOUT_PROCESSED
  PAYOUT_SCHEDULED
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_REJECTED
  REFUND_PROCESSED
  REFERRAL_REWARD_ISSUED
  COURSE_INTEREST_REMINDER
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum DisputeReferenceType {
  ENROLLMENT
  PAYMENT
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  UTILITY_BILL
  BANK_STATEMENT
  OTHER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum LiveSessionStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum ReportTargetType {
  COURSE
  COMMENT
  PROFILE
}

enum ReportCategory {
  SPAM
  HARASSMENT
  HATE_SPEECH
  MISINFORMATION
  INAPPROPRIATE_CONTENT
  SCAM_FRAUD
  COPYRIGHT
  OTHER
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING        // submitted, awaiting moderator review
  UNDER_REVIEW   // a moderator has picked it up
  RESOLVED       // action was taken on the target
  DISMISSED      // reviewed, no action needed
}

enum FraudRiskLevel {
  LOW       // score 0-39   — no action
  MEDIUM    // score 40-69  — no action (internal logging only)
  HIGH      // score 70-89  — enrollment flagged, proceeds normally
  CRITICAL  // score 90-100 — enrollment blocked (automatic hold)
}

enum FraudFlagStatus {
  OPEN      // flagged, awaiting admin review
  HELD      // enrollment blocked by automatic hold
  CLEARED   // admin reviewed — no fraud found
  CONFIRMED // admin confirmed fraud — enrollment voided
}

enum ReferralStatus {
  SIGNED_UP      // referred user registered with a valid code
  CONVERTED      // referred user completed first enrollment
}

enum ReferralRewardStatus {
  PENDING        // awaiting conversion before issuance
  ISSUED         // discount available for use
  REDEEMED       // applied to an enrollment
  EXPIRED
  CANCELLED
}

enum ReferralRewardKind {
  REFERRER       // reward for the student who shared the code
  REFEREE        // welcome discount for the new user
}

enum SmsStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum SmsTemplateKey {
  ACCOUNT_VERIFICATION
  ENROLLMENT_CONFIRMED
  PAYMENT_RECEIVED
  PASSWORD_RESET
  GENERIC_ALERT
}

enum PointsActivityType {
  DAILY_LOGIN
  LESSON_COMPLETED
  ASSIGNMENT_SUBMITTED
  EXAM_PASSED
  COURSE_COMPLETED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id             String    @id @default(uuid())
  stellarAddress String?   @unique
  googleId       String?   @unique
  email          String?   @unique
  name           String?
  bio            String?
  avatarUrl      String?
  role           UserRole  @default(STUDENT)
  isVerified     Boolean   @default(false)
  phoneNumber    String?
  phoneCountryCode String?
  isPhoneVerified Boolean  @default(false)
  phoneVerifiedAt DateTime?
  isBanned       Boolean   @default(false)
  bannedAt       DateTime?
  banReason      String?
  isSuspended    Boolean   @default(false)
  suspendedAt    DateTime?
  suspendedUntil DateTime?
  suspensionReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  coursesCreated      Course[]              @relation("InstructorCourses")
  enrollments         Enrollment[]
  assignments         AssignmentSubmission[]
  notifications       Notification[]
  certificates        Certificate[]
  examAttempts        ExamAttempt[]
  payouts             Payout[]              @relation("Payouts")
  reportsFiled        AbuseReport[]         @relation("ReportsFiled")
  reportsHandled      AbuseReport[]         @relation("ReportsHandled")
  reviews             CourseReview[]
  discussionComments  DiscussionComment[]
  fraudFlags          EnrollmentFraudFlag[] @relation("StudentFraudFlags")
  fraudReviewed       EnrollmentFraudFlag[] @relation("FraudReviewedBy")
  refundRequests      Refund[]
  bundlesCreated      Bundle[]              @relation("InstructorBundles")
  bundleEnrollments   BundleEnrollment[]
  invoices            Invoice[]
  couponsCreated      Coupon[]              @relation("CouponCreator")
  couponRedemptions   CouponRedemption[]    @relation("CouponRedemptions")
  disputesFiled       Dispute[]             @relation("DisputesFiled")
  disputesResolved    Dispute[]             @relation("DisputesResolved")
  kycSubmissions      KycSubmission[]       @relation("KycSubmissions")
  kycReviews          KycSubmission[]       @relation("KycReviews")
  payoutSchedule      PayoutSchedule?       @relation("PayoutSchedule")
  referralCode        ReferralCode?
  referralsMade       Referral[]            @relation("ReferralsMade")
  referralReceived    Referral?             @relation("ReferredBy")
  referralRewards     ReferralReward[]      @relation("ReferralRewards")
  deviceTokens        NotificationDeviceToken[]
  notificationPreferences NotificationPreference[]
  digestPreference    NotificationDigestPreference?
  auditLogs           AdminAuditLog[]       @relation("AuditLogActor")
  courseRestoreJobs   CourseRestoreJob[]    @relation("CourseRestoreRequester")
  smsMessages         SmsMessage[]
  wishlistItems       WishlistItem[]
  points              UserPoints?
  pointsAwards        PointsAward[]
  questionsAsked      Question[]            @relation("QuestionsAsked")
  answersGiven        Answer[]              @relation("AnswersGiven")
  courseDrafts        CourseDraft[]         @relation("InstructorCourseDrafts")
  learningPathsCreated LearningPath[]       @relation("LearningPathCreator")
  phoneOtps            PhoneOtp[]           @relation("UserPhoneOtps")
  sessions            Session[]             @relation("UserSessions")

  @@map("users")
}

model PhoneOtp {
  id           String    @id @default(uuid())
  userId       String
  phoneNumber  String
  countryCode  String
  otp          String
  attemptCount Int       @default(0)
  expiresAt    DateTime
  verifiedAt   DateTime?
  isUsed       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation("UserPhoneOtps", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneNumber])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("phone_otp")
// Tracks an issued JWT so it can be listed and revoked per device (issue #69).
model Session {
  id           String    @id @default(uuid())
  userId       String
  jti          String    @unique // matches the `jti` claim embedded in the JWT
  deviceLabel  String?   // parsed friendly label, e.g. "Chrome on Windows"
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  // Relations
  user User @relation("UserSessions", fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Course {
  id                  String       @id  // matches on-chain course_id
  instructorAddress   String
  title               String
  description         String?
  category            String       // e.g. "Tailoring", "Makeup", "Baking"
  level               String       @default("Beginner") // Beginner | Intermediate | Advanced
  language            String       @default("English")
  thumbnailUrl        String?
  previewVideoUrl     String?
  price               Decimal      // in USDC (human-readable, e.g. 50.00)
  platformFeePercent  Int          @default(20)
  status              CourseStatus @default(DRAFT)
  totalLessons        Int          @default(0)
  totalDuration       Int          @default(0) // minutes
  totalEnrollments    Int          @default(0)
  totalRevenue        Decimal      @default(0)
  avgRating           Float        @default(0)
  totalReviews        Int          @default(0)
  txHash              String?      // on-chain registration tx
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  instructor    User          @relation("InstructorCourses", fields: [instructorAddress], references: [stellarAddress])
  modules       CourseModule[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  events        ChainEvent[]
  exam          Exam?
  liveSessions  LiveSession[]
  reviews       CourseReview[]
  bundleCourses BundleCourse[]
  invoices      Invoice[]
  coupons       Coupon[]
  wishlistItems WishlistItem[]
  tags          CourseTag[]
  pathCourses   LearningPathCourse[]
  prerequisites CoursePrerequisite[] @relation("CourseRequires") // this course requires them
  unlocks       CoursePrerequisite[] @relation("CourseUnlocks")  // courses requiring this one
  dripConfig    CourseDripConfig?

  @@map("courses")
}


model CourseSearchTerm {
  id             String   @id @default(uuid())
  term           String   @unique
  searchCount    Int      @default(0)
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([searchCount])
  @@index([lastSearchedAt])
  @@map("course_search_terms")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  position    Int      // ordering within the course
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  course   Course   @relation(fields: [courseId], references: [id])
  lessons  Lesson[]

  @@map("course_modules")
}

model Lesson {
  id           String      @id @default(uuid())
  moduleId     String
  title        String
  description  String?
  type         LessonType  @default(VIDEO)
  videoUrl     String?     // URL to video file (S3 / local)
  videoDuration Int?       // seconds
  thumbnailUrl String?     // URL to auto-generated or manually set thumbnail
  content      String?     // for TEXT type lessons
  resourceUrl  String?     // downloadable resource
  position     Int         // ordering within the module
  isFree       Boolean     @default(false) // preview lesson
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  module      CourseModule @relation(fields: [moduleId], references: [id])
  progress    LessonProgress[]
  assignment  Assignment?
  quizQuestions QuizQuestion[]
  questions   Question[]
  dripConfig  LessonDripConfig?
  dripUnlocks EnrollmentLessonUnlock[]

  @@map("lessons")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  lessonId      String
  question      String
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json?        // Array of options, e.g. ["Option A", "Option B"]
  correctAnswer Json         // Array of correct indices, e.g. [0], or text answer ["True"]
  explanation   String?
  points        Int          @default(1)
  position      Int          // ordering within the lesson
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("quiz_questions")
}

model Assignment {
  id           String   @id @default(uuid())
  lessonId     String   @unique
  title        String
  description  String
  instructions String?
  createdAt    DateTime @default(now())

  // Relations
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  submissionUrl String?         // uploaded file or link
  notes        String?
  status       AssignmentStatus @default(PENDING)
  feedback     String?          // instructor feedback
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Enrollment {
  id              String           @id @default(uuid())
  studentId       String
  courseId        String
  amountPaid      Decimal          // USDC paid
  txHash          String?          // on-chain enrollment tx
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Int              @default(0)  // 0-100
  completedAt     DateTime?
  enrolledAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  student        User                 @relation(fields: [studentId], references: [id])
  course         Course               @relation(fields: [courseId], references: [id])
  lessonProgress LessonProgress[]
  refunds        Refund[]
  invoice        Invoice?
  fraudFlag      EnrollmentFraudFlag?
  dripUnlocks    EnrollmentLessonUnlock[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model CourseDripConfig {
  id               String   @id @default(uuid())
  courseId         String   @unique
  enabled          Boolean  @default(false)
  dripIntervalDays Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_drip_configs")
}

model LessonDripConfig {
  id         String    @id @default(uuid())
  lessonId   String    @unique
  delayDays  Int       @default(0)
  unlockDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_drip_configs")
}

model EnrollmentLessonUnlock {
  id           String    @id @default(uuid())
  enrollmentId String
  lessonId     String
  unlockAt     DateTime
  isOverridden Boolean   @default(false)
  overriddenBy String?
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([unlockAt])
  @@map("enrollment_lesson_unlocks")
}

model WishlistItem {
  id             String    @id @default(uuid())
  studentId      String
  courseId       String
  lastReminderAt DateTime?
  reminderCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  // Relations
  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@map("wishlist_items")
}

model LessonProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  lessonId     String
  completed    Boolean  @default(false)
  watchedSecs  Int      @default(0) // seconds watched
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  lesson     Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model Certificate {
  id              String   @id  // matches on-chain certificate_id
  studentId       String
  courseId        String
  courseTitle     String   // stored for quick display
  instructorAddress String
  txHash          String?  // on-chain certificate issuance tx
  pdfUrl          String?  // generated PDF file reference/URL
  isRevoked       Boolean  @default(false)
  issuedAt        DateTime @default(now())

  // Relations
  student User              @relation(fields: [studentId], references: [id])
  course  Course            @relation(fields: [courseId], references: [id])
  share   CertificateShare?

  @@map("certificates")
}

model CertificateShare {
  id            String    @id @default(uuid())
  certificateId String   @unique
  token         String    @unique
  viewCount     Int       @default(0)
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("certificate_shares")
}

// Admin-configured certificate branding/layout per course category.
// At most one template may be active for a given category (enforced in SQL
// via a partial unique index and in the service on activation).
model CertificateTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String   // matches Course.category, e.g. "Tailoring"
  branding    Json     // logo, colors, organization name, footer
  layout      Json     // orientation, title/body copy, field visibility
  signatures  Json     // [{ name, label, title?, imageUrl? }]
  isActive    Boolean  @default(false)
  createdById String
  activatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([category, isActive])
  @@map("certificate_templates")
}

model ChainEvent {
  id         String   @id @default(uuid())
  courseId   String?
  eventName  String
  ledger     Int
  txHash     String
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  course Course? @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([eventName])
  @@index([processed])
  @@map("chain_events")
}

/// Durable checkpoint for the Stellar event poller (EventsService).
/// A single row (keyed by `key`) records the last Stellar ledger the poller
/// finished processing so the service can resume from it after a restart or
/// crash instead of replaying from the chain tip and missing events.
model EventPollerCheckpoint {
  id                       String    @id @default(uuid())
  key                      String    @unique
  lastProcessedLedger      Int       @default(0)
  lastPolledAt             DateTime?
  lastWriteError           String?
  consecutiveWriteFailures Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("event_poller_checkpoints")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model NotificationDeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?  @default("mobile")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@map("notification_device_tokens")
}

model NotificationPreference {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  email     Boolean          @default(true)
  push      Boolean          @default(true)
  inApp     Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

model NotificationDigestPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  emailEnabled  Boolean  @default(true)
  lastDigestAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("notification_digest_preferences")
}

model SmsMessage {
  id                String          @id @default(uuid())
  userId            String?
  phoneNumber       String          // normalized E.164
  countryCode       String
  templateKey       SmsTemplateKey?
  message           String
  status            SmsStatus       @default(PENDING)
  providerMessageId String?         @unique
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("sms_messages")
}

model Exam {
  id            String        @id @default(uuid())
  courseId      String        @unique
  title         String
  description   String?
  passingScore  Int           @default(70) // percentage 0-100
  cooldownHours Int           @default(24) // retake cooldown in hours
  questions     Json          // Array of exam questions with correct answers
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  course        Course        @relation(fields: [courseId], references: [id])
  attempts      ExamAttempt[]

  @@map("exams")
}

model ExamAttempt {
  id          String   @id @default(uuid())
  examId      String
  studentId   String
  score       Int      // score percentage achieved
  passed      Boolean
  answers     Json?    // Submitted answers
  attemptedAt DateTime @default(now())

  exam        Exam     @relation(fields: [examId], references: [id])
  student     User     @relation(fields: [studentId], references: [id])

  @@index([examId, studentId])
  @@map("exam_attempts")
}

model LiveSession {
  id                String            @id @default(uuid())
  courseId          String
  instructorAddress String
  title             String
  description       String?
  scheduledAt       DateTime
  durationMinutes   Int               @default(60)
  capacity          Int               @default(50)
  meetingUrl        String?
  status            LiveSessionStatus @default(SCHEDULED)
  reminderSent      Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  course            Course            @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([instructorAddress])
  @@index([scheduledAt, status])
  @@map("live_sessions")
}

model PayoutSchedule {
  id                String          @id @default(uuid())
  instructorId      String          @unique
  frequency         PayoutFrequency @default(MONTHLY)
  minimumThreshold  Decimal         @default(10) // minimum USDC to trigger payout
  stellarAddress    String          // payout destination address
  isActive          Boolean         @default(true)
  nextPayoutDate    DateTime
  lastPayoutDate    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  instructor User     @relation("PayoutSchedule", fields: [instructorId], references: [id])
  payouts    Payout[]

  @@map("payout_schedules")
}

model Payout {
  id               String          @id @default(uuid())
  scheduleId       String?
  instructorId     String
  amount           Decimal         // USDC amount
  currency         String          @default("USDC")
  status           PayoutStatus    @default(PENDING)
  txHash           String?         // on-chain payout tx
  periodStart      DateTime?
  periodEnd        DateTime?
  notes            String?
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  schedule    PayoutSchedule? @relation(fields: [scheduleId], references: [id])
  instructor  User            @relation("Payouts", fields: [instructorId], references: [id])

  @@index([instructorId])
  @@index([status])
  @@map("payouts")
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal      // percentage (0-100) or fixed USDC amount
  maxRedemptions  Int?         // null = unlimited
  redeemedCount   Int          @default(0)
  minOrderAmount  Decimal?     // minimum cart total to apply coupon
  expiresAt       DateTime?    // null = never expires
  isActive        Boolean      @default(true)
  createdById     String       // User (ADMIN or INSTRUCTOR) who created it
  courseId        String?      // null = platform-wide, set = specific course only
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  createdBy   User          @relation("CouponCreator", fields: [createdById], references: [id])
  course      Course?       @relation(fields: [courseId], references: [id])
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  courseId  String
  discount  Decimal  // actual discount amount applied
  redeemedAt DateTime @default(now())

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation("CouponRedemptions", fields: [userId], references: [id])

  @@unique([couponId, userId, courseId])
  @@map("coupon_redemptions")
}

// ============================================================
// DISPUTES
// ============================================================

model Dispute {
  id             String               @id @default(uuid())
  filedById      String               // student who filed
  referenceType  DisputeReferenceType
  referenceId    String               // enrollmentId or payment txHash
  subject        String
  description    String
  status         DisputeStatus        @default(OPEN)
  adminNotes     String?
  resolvedById   String?              // admin who resolved
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relations
  filedBy    User  @relation("DisputesFiled", fields: [filedById], references: [id])
  resolvedBy User? @relation("DisputesResolved", fields: [resolvedById], references: [id])

  @@index([filedById])
  @@index([status])
  @@map("disputes")
}

// ============================================================
// KYC (Know Your Customer — instructor identity verification)
// ============================================================

model KycSubmission {
  id             String          @id @default(uuid())
  instructorId   String
  documentType   KycDocumentType
  documentUrl    String          // uploaded file path / URL
  additionalUrl  String?         // second document (e.g. selfie)
  status         KycStatus       @default(PENDING)
  adminNotes     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  instructor  User  @relation("KycSubmissions", fields: [instructorId], references: [id])
  reviewedBy  User? @relation("KycReviews", fields: [reviewedById], references: [id])

  @@index([instructorId])
  @@index([status])
  @@map("kyc_submissions")
}

model AbuseReport {
  id             String           @id @default(uuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String           // no cross-table FK: targetType decides which table targetId refers to
  category       ReportCategory
  severity       ReportSeverity   @default(MEDIUM)
  description    String?
  status         ReportStatus     @default(PENDING)
  resolvedById   String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  reporter   User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportsHandled", fields: [resolvedById], references: [id])

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@map("abuse_reports")
}

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  studentId String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course  Course @relation(fields: [courseId], references: [id])
  student User   @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
  @@index([courseId])
  @@map("course_reviews")
}

model UserPoints {
  id               String    @id @default(uuid())
  userId           String    @unique
  totalPoints      Int       @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("user_points")
}

model PointsAward {
  id           String             @id @default(uuid())
  userId       String
  activityType PointsActivityType
  points       Int
  awardedDate  DateTime           // midnight-normalized date the award applies to
  createdAt    DateTime           @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, activityType, awardedDate])
  @@index([userId])
  @@map("points_awards")
}

model Question {
  id        String   @id @default(uuid())
  lessonId  String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lesson  Lesson   @relation(fields: [lessonId], references: [id])
  author  User     @relation("QuestionsAsked", fields: [authorId], references: [id])
  answers Answer[]

  @@index([lessonId])
  @@map("questions")
}

model Answer {
  id           String   @id @default(uuid())
  questionId   String
  authorId     String
  content      String
  isBestAnswer Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  question Question @relation(fields: [questionId], references: [id])
  author   User     @relation("AnswersGiven", fields: [authorId], references: [id])

  @@index([questionId])
  @@map("answers")
}

model DiscussionComment {
  id              String               @id @default(uuid())
  discussionId    String
  authorId        String
  content         String
  hidden          Boolean              @default(false)
  flaggedCount    Int                  @default(0)
  reviewStatus    CommentReviewStatus  @default(PENDING)
  moderationNotes String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  author User @relation(fields: [authorId], references: [id])

  @@index([discussionId])
  @@index([authorId])
  @@map("discussion_comments")
}

model EnrollmentFraudFlag {
  id           String          @id @default(uuid())
  enrollmentId String          @unique
  studentId    String
  riskScore    Int             // computed 0–100
  riskLevel    FraudRiskLevel
  reasons      Json            // string[] of triggered rule names
  status       FraudFlagStatus @default(OPEN)
  reviewedById String?
  reviewNotes  String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id])
  student    User        @relation("StudentFraudFlags", fields: [studentId], references: [id])
  reviewedBy User?       @relation("FraudReviewedBy", fields: [reviewedById], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([riskLevel])
  @@map("enrollment_fraud_flags")
}

model Refund {
  id              String       @id @default(uuid())
  enrollmentId    String
  studentId       String
  reason          String
  requestedAmount Decimal      // USDC requested by the student
  approvedAmount  Decimal?     // USDC approved by the admin (may be partial)
  isPartial       Boolean      @default(false)
  status          RefundStatus @default(PENDING)
  adminNote       String?
  txHash          String?      // on-chain refund transaction, set once processed
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@index([enrollmentId])
  @@index([studentId])
  @@index([status])
  @@map("refunds")
}

model Bundle {
  id                String   @id @default(uuid())
  instructorAddress String
  title             String
  description       String?
  price             Decimal  // USDC, discounted vs sum of individual course prices
  thumbnailUrl      String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  instructor  User               @relation("InstructorBundles", fields: [instructorAddress], references: [stellarAddress])
  courses     BundleCourse[]
  enrollments BundleEnrollment[]

  @@index([instructorAddress])
  @@map("bundles")
}

model BundleCourse {
  id       String @id @default(uuid())
  bundleId String
  courseId String

  // Relations
  bundle Bundle @relation(fields: [bundleId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([bundleId, courseId])
  @@map("bundle_courses")
}

model BundleEnrollment {
  id         String   @id @default(uuid())
  bundleId   String
  studentId  String
  amountPaid Decimal  // USDC
  txHash     String?  // on-chain bundle purchase tx
  enrolledAt DateTime @default(now())

  // Relations
  bundle  Bundle @relation(fields: [bundleId], references: [id])
  student User   @relation(fields: [studentId], references: [id])

  @@unique([bundleId, studentId])
  @@map("bundle_enrollments")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber Int      @unique @default(autoincrement())
  enrollmentId  String   @unique
  studentId     String
  courseId      String
  amount        Decimal  // USDC amount invoiced
  txHash        String?
  emailSent     Boolean  @default(false)
  issuedAt      DateTime @default(now())

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])

  @@map("invoices")
}

// ============================================================
// REFERRALS
// ============================================================

model ReferralCode {
  id               String   @id @default(uuid())
  userId           String   @unique
  code             String   @unique
  isActive         Boolean  @default(true)
  totalSignups     Int      @default(0)
  totalConversions Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id])
  referrals Referral[]

  @@map("referral_codes")
}

model Referral {
  id             String         @id @default(uuid())
  referralCodeId String
  referrerId     String
  referredUserId String         @unique
  status         ReferralStatus @default(SIGNED_UP)
  signedUpAt     DateTime       @default(now())
  convertedAt    DateTime?
  enrollmentId   String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  referralCode ReferralCode     @relation(fields: [referralCodeId], references: [id])
  referrer     User             @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredUser User             @relation("ReferredBy", fields: [referredUserId], references: [id])
  rewards      ReferralReward[]

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralReward {
  id            String               @id @default(uuid())
  referralId    String
  beneficiaryId String
  kind          ReferralRewardKind
  discountType  DiscountType         @default(PERCENTAGE)
  discountValue Decimal
  status        ReferralRewardStatus @default(PENDING)
  enrollmentId  String?
  issuedAt      DateTime?
  redeemedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  referral    Referral @relation(fields: [referralId], references: [id])
  beneficiary User     @relation("ReferralRewards", fields: [beneficiaryId], references: [id])

  @@index([beneficiaryId, status])
  @@index([referralId])
  @@map("referral_rewards")
}

// ============================================================
// TAGS
// ============================================================

model Tag {
  id         String   @id @default(uuid())
  name       String   @unique  // normalized lowercase slug, e.g. "web-design"
  label      String            // display label, e.g. "Web Design"
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  courses CourseTag[]

  @@index([usageCount])
  @@index([name])
  @@map("tags")
}

model CourseTag {
  id       String @id @default(uuid())
  courseId String
  tagId    String

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([courseId, tagId])
  @@index([courseId])
  @@index([tagId])
  @@map("course_tags")
}

// ============================================================
// ADMIN AUDIT LOG
// ============================================================

enum AuditAction {
  // User management
  USER_BANNED
  USER_UNBANNED
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_ROLE_CHANGED

  // Course lifecycle
  COURSE_APPROVED
  COURSE_REJECTED
  COURSE_PAUSED
  COURSE_ARCHIVED

  // KYC
  KYC_APPROVED
  KYC_REJECTED

  // Disputes
  DISPUTE_RESOLVED
  DISPUTE_REJECTED
  DISPUTE_CLOSED

  // Refunds
  REFUND_APPROVED
  REFUND_REJECTED
  REFUND_PROCESSED

  // Payouts
  PAYOUT_PROCESSED
  PAYOUT_SCHEDULED

  // Coupons
  COUPON_CREATED
  COUPON_DEACTIVATED

  // Abuse reports
  REPORT_RESOLVED
  REPORT_DISMISSED

  // Admin impersonation
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED

  // Tags
  TAG_CREATED
  TAG_UPDATED
  TAG_DELETED
  TAG_MERGED

  // Generic admin note
  ADMIN_MANUAL_NOTE
}

enum AuditTargetType {
  USER
  COURSE
  KYC_SUBMISSION
  DISPUTE
  REFUND
  PAYOUT
  COUPON
  ABUSE_REPORT
  TAG
}

model AdminAuditLog {
  id         String          @id @default(uuid())
  actorId    String          // The admin who performed the action
  action     AuditAction
  targetType AuditTargetType
  targetId   String          // ID of the entity acted upon
  metadata   Json?           // Extra context: old/new values, notes, etc.
  ipAddress  String?         // Request IP for compliance tracing
  createdAt  DateTime        @default(now()) // Intentionally no updatedAt — entries are immutable

  // Relations
  actor User @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ============================================================
// ANALYTICS EVENTS
// ============================================================

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String
  userId     String?
  sessionId  String?
  path       String?
  properties Json?
  userAgent  String?
  ipAddress  String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@map("analytics_events")
}

// COURSE DATA RESTORE
// ============================================================

enum CourseRestoreStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model CourseRestoreJob {
  id              String              @id @default(uuid())
  requestedBy     String
  status          CourseRestoreStatus @default(PENDING)
  progressPercent Int                 @default(0)
  totalSteps      Int                 @default(0)
  completedSteps  Int                 @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  backupPayload   Json
  validationErrors Json?
  summary         Json?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requester User @relation("CourseRestoreRequester", fields: [requestedBy], references: [id])

  @@index([status])
  @@index([scheduledFor])
  @@index([requestedBy])
  @@map("course_restore_jobs")
}

// ============================================================
// COURSE AUTOSAVE DRAFTS
// ============================================================

model CourseDraft {
  id                String   @id @default(uuid())
  courseId          String?
  instructorId      String
  instructorAddress String
  title             String?
  data              Json
  version           Int      @default(1)
  lastSavedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instructor User @relation("InstructorCourseDrafts", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([courseId])
  @@index([lastSavedAt])
  @@map("course_drafts")
}

// ============================================================
// LEARNING PATHS
// ============================================================

enum LearningPathStatus {
  DRAFT      // admin still curating courses and order
  PUBLISHED  // visible to students for enrollment
  ARCHIVED   // retired from student listings
}

model LearningPath {
  id           String             @id @default(uuid())
  title        String
  slug         String             @unique // normalised, URL-safe identifier
  description  String?
  thumbnailUrl String?
  status       LearningPathStatus @default(DRAFT)
  createdById  String
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  createdBy User                 @relation("LearningPathCreator", fields: [createdById], references: [id])
  courses   LearningPathCourse[]

  @@index([status])
  @@index([createdById])
  @@map("learning_paths")
}

model LearningPathCourse {
  id       String @id @default(uuid())
  pathId   String
  courseId String
  position Int    // ordering within the path (0-based)

  // Relations
  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@unique([pathId, position])
  @@index([pathId])
  @@index([courseId])
  @@map("learning_path_courses")
}

// ============================================================
// COURSE PREREQUISITES
// ============================================================

model CoursePrerequisite {
  id             String @id @default(uuid())
  courseId       String // course that REQUIRES the prerequisite
  prerequisiteId String // course that must be COMPLETED first

  // Relations
  course       Course @relation("CourseRequires", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("CourseUnlocks", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@index([courseId])
  @@index([prerequisiteId])
  @@map("course_prerequisites")
}
